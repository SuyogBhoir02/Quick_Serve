<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/viewpage2">

    <TextView
        android:id="@+id/textViewUpiId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter UPI ID"
        android:layout_marginTop="300dp"
        android:layout_marginStart="20dp"/>

    <EditText
        android:id="@+id/editTextUpiId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textEmailAddress"
        android:hint="Enter UPI ID"
        android:layout_marginTop="280dp"
        android:layout_toEndOf="@id/textViewUpiId"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>

    <TextView
        android:id="@+id/textViewAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Amount"
        android:layout_below="@id/textViewUpiId"
        android:layout_marginTop="40dp"
        android:layout_marginStart="20dp"/>

    <EditText
        android:id="@+id/editTextAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Enter Amount"
        android:layout_toEndOf="@id/textViewAmount"
        android:layout_below="@id/editTextUpiId"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/buttonPay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pay"
        android:layout_below="@id/editTextAmount"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="144dp"
        android:layout_marginTop="133dp"
        android:layout_marginEnd="129dp"
        android:layout_marginBottom="620dp"
        android:background="@drawable/gpay2" />

    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:padding="4dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/arrow" />

    <ImageView
        android:id="@+id/btnPayQ"
        android:layout_width="70dp"
        android:layout_height="32dp"
        android:layout_below="@id/editTextAmount"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:background="@drawable/exit1" />

</RelativeLayout>